{
  "name": "@golems/content",
  "version": "1.0.0",
  "description": "ContentGolem — content creation and publishing for LinkedIn, Soltome, and ghostwriting with critique-wave refinement.",
  "author": "Etan Heyman <etan@heyman.net>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/EtanHey/golems",
    "directory": "packages/content"
  },
  "keywords": [
    "golems",
    "ai-agent",
    "content-creation",
    "linkedin",
    "publishing",
    "remotion",
    "video"
  ],
  "scripts": {
    "validate-brand": "bun run scripts/validate-brand.ts",
    "render": "bun run scripts/render.ts render",
    "render:list": "bun run scripts/render.ts list",
    "render:still": "bun run scripts/render.ts still",
    "render:preview": "bun run scripts/render.ts preview",
    "studio": "cd remotion && bunx remotion studio src/index.ts"
  },
  "exports": {
    "./*": "./src/*.ts",
    "./brand": "./src/brand/index.ts",
    "./brand/*": "./src/brand/*.ts",
    "./remotion": "./src/remotion/index.ts",
    "./remotion/*": "./src/remotion/*.ts",
    "./render": "./src/render/index.ts"
  },
  "dependencies": {
    "@golems/shared": "workspace:*",
    "@remotion/google-fonts": "4.0.421",
    "@remotion/paths": "4.0.421"
  },
  "peerDependencies": {
    "remotion": "4.0.421"
  }
}
