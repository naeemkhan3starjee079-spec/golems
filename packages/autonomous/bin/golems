#!/usr/bin/env bash
#
# golems - System status and control CLI
# Usage: golems [command]
#

set -e

GOLEMS_HOME="${GOLEMS_HOME:-$HOME/Gits/golems}"
LOGS_DIR="$HOME/.golems-zikaron/logs"
STATE_FILE="$HOME/.golems-zikaron/state.json"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
GRAY='\033[0;90m'
NC='\033[0m' # No Color

status_icon() {
  case "$1" in
    0) echo -e "${GREEN}✓${NC}" ;;
    1) echo -e "${RED}✗${NC}" ;;
    *) echo -e "${YELLOW}?${NC}" ;;
  esac
}

cmd_help() {
  cat << 'EOF'
golems - Golem System CLI

USAGE:
  golems [command]

COMMANDS:
  status        Show all services status (default)
  tui           Interactive React Ink dashboard (keyboard navigation)
  doctor        Health check all services + diagnostics
  services      Detailed launchd service status
  scrape        Trigger job scrape now
  sessions      Claude sessions (active, registry, spawn <repo>)
  logs [name]   Show logs (telegram, nightshift, job-golem, etc.)

  start [svc]   Start a service (telegram, nightshift, ollama, comfyui, render-service)
  stop [svc]    Stop a service
  restart [svc] Restart a service

  reload [svc]  Reload service (picks up code changes)
  clear-errors  Clear launchd error states

  latest        Restart all services to pick up latest code
  on            Turn on all services (exit hibernation)
  off           Turn off all services (hibernation mode)

  cloud         Show Railway cloud worker health + usage
  helpers       Show external CLI helper backends status
  instructions  Show Claude Chat project files to upload
  enrich        Zikaron enrichment (start [N], stop, status)
  style         Style profiles (v2|v1|build|show)
  setup|wizard  Setup wizard (check, status, continue, add-project <path>)
  autopilot     Toggle autonomous plan execution (on/off/status)
  skills        Show available integrations and their status
  costs         API cost tracking (summary, by-source, by-model, daily, log)
  maintain      Run maintenance checks (deps, files, config, services)
  config        Show/init/edit centralized config (~/.golems/config.yaml)
  update        Self-update golems (pull, install deps, restart services)
  version       Show current version info
  queue         Chat queue controls (list, add, edit, remove, clean)
  explore       Codebase exploration with CLI agents (templates, agents, latest)
  mascot        Guardian golem ASCII art (--color, --plain, --simple)
  sweep         Run quality sweep (package.json, tests, TS, docs, git)
  rules         Check/export/list Claude Code rules (rules-library)
  i18n          Internationalization info (locale, keys, set)
  e2e           Run Playwright E2E tests (admin-ui + docsite)
  index-whatsapp <file> --chat "Name"  Index WhatsApp export in Zikaron

  help          Show this help

EXAMPLES:
  golems                # Quick status overview
  golems doctor         # Health check all services
  golems services       # Detailed service status
  golems logs telegram  # Tail telegram bot logs
  golems restart telegram
  golems scrape         # Trigger job scrape now
  golems latest         # Deploy latest code to all services
  golems off            # Hibernate (stop all services)
  golems on             # Wake up (start all services)

DOCS:
  ~/Gits/golems/CLAUDE.md

EOF
}

cmd_status() {
  echo -e "${BLUE}=== GOLEMS STATUS ===${NC}"
  echo

  # Telegram bot
  if lsof -i :3847 &>/dev/null; then
    echo -e "$(status_icon 0) Telegram Bot     running (port 3847)"
  else
    echo -e "$(status_icon 1) Telegram Bot     not running"
  fi

  # Ollama (local, via launchd)
  if pgrep -q ollama 2>/dev/null; then
    echo -e "$(status_icon 0) Ollama           running"
  else
    echo -e "$(status_icon 1) Ollama           not running"
  fi

  # ComfyUI (local, on-demand)
  if curl -s --max-time 2 http://127.0.0.1:8188/system_stats &>/dev/null; then
    echo -e "$(status_icon 0) ComfyUI          running (port 8188)"
  else
    echo -e "$(status_icon 1) ComfyUI          not running"
  fi

  # Render Service (local, on-demand)
  if curl -s --max-time 2 http://127.0.0.1:3001/api/health &>/dev/null; then
    echo -e "$(status_icon 0) Render Service   running (port 3001)"
  else
    echo -e "$(status_icon 1) Render Service   not running"
  fi

  # LaunchAgents summary
  echo
  echo -e "${BLUE}LaunchAgents:${NC}"
  for svc in nightshift briefing job-golem email-golem session-archiver storage-cleanup; do
    status=$(launchctl list 2>/dev/null | grep "com.golemszikaron.$svc\|com.golems.$svc" | awk '{print $1}')
    if [ -z "$status" ]; then
      echo -e "  $(status_icon 1) $svc (not loaded)"
    elif [ "$status" = "0" ] || [ "$status" = "-" ]; then
      echo -e "  $(status_icon 0) $svc"
    else
      echo -e "  $(status_icon 1) $svc (exit: $status)"
    fi
  done

  # Claude sessions
  sessions=$(ps aux | grep -c "[c]laude " 2>/dev/null || echo 0)
  echo
  echo -e "${BLUE}Claude Sessions:${NC} $sessions running"

  # State info
  if [ -f "$STATE_FILE" ]; then
    target=$(jq -r '.nightShiftTarget // "none"' "$STATE_FILE" 2>/dev/null)
    echo -e "${BLUE}Night Shift Target:${NC} $target"
  fi
}

SERVICE_STATE_FILE="$HOME/.golems/service-state.json"

cmd_services() {
  case "${1:-list}" in
    list|"")
      echo -e "${BLUE}=== LAUNCHD SERVICES ===${NC}"
      echo
      printf "%-25s %-8s %s\n" "SERVICE" "STATUS" "NOTES"
      printf "%-25s %-8s %s\n" "-------" "------" "-----"

      launchctl list 2>/dev/null | grep -E "golem|zikaron" | while read pid exitcode label; do
        if [ "$pid" = "-" ]; then
          if [ "$exitcode" = "0" ]; then
            status="idle"
          else
            status="err:$exitcode"
          fi
        else
          status="running"
        fi
        printf "%-25s %-8s %s\n" "$label" "$status" ""
      done

      # Also check on-demand services by port
      echo
      echo -e "${BLUE}On-Demand Services:${NC}"
      if curl -s --max-time 2 http://127.0.0.1:8188/system_stats &>/dev/null; then
        echo -e "  $(status_icon 0) ComfyUI (port 8188)"
      else
        echo -e "  $(status_icon 1) ComfyUI (not running)"
      fi
      if curl -s --max-time 2 http://127.0.0.1:3001/api/health &>/dev/null; then
        echo -e "  $(status_icon 0) Render Service (port 3001)"
      else
        echo -e "  $(status_icon 1) Render Service (not running)"
      fi
      ;;

    snapshot)
      echo -e "${BLUE}=== SNAPSHOT SERVICE STATE ===${NC}"
      mkdir -p "$(dirname "$SERVICE_STATE_FILE")"
      local running=()
      # Check each known service
      for svc in telegram ollama comfyui render-service; do
        case "$svc" in
          comfyui)
            curl -s --max-time 2 http://127.0.0.1:8188/system_stats &>/dev/null && running+=("$svc")
            ;;
          render-service)
            curl -s --max-time 2 http://127.0.0.1:3001/api/health &>/dev/null && running+=("$svc")
            ;;
          telegram)
            lsof -i :3847 &>/dev/null && running+=("$svc")
            ;;
          ollama)
            pgrep -q ollama 2>/dev/null && running+=("$svc")
            ;;
        esac
      done
      # Also check launchd services (include loaded/idle — they're scheduled)
      for svc in nightshift briefing job-golem email-golem session-archiver storage-cleanup; do
        local label="$(_svc_label "$svc")"
        if launchctl list 2>/dev/null | grep -q "$label"; then
          running+=("$svc")
        fi
      done
      # Write state (handle empty array correctly)
      local json_arr=""
      if [ ${#running[@]} -gt 0 ]; then
        json_arr="$(printf '"%s",' "${running[@]}" | sed 's/,$//')"
      fi
      printf '{"timestamp":"%s","running":[%s]}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        "$json_arr" \
        > "$SERVICE_STATE_FILE"
      echo "Saved state: ${running[*]:-none}"
      echo "File: $SERVICE_STATE_FILE"
      ;;

    restore)
      echo -e "${BLUE}=== RESTORE SERVICE STATE ===${NC}"
      if [ ! -f "$SERVICE_STATE_FILE" ]; then
        echo "No snapshot found. Run: golems services snapshot"
        return 1
      fi
      local saved=$(cat "$SERVICE_STATE_FILE")
      local timestamp=$(echo "$saved" | jq -r '.timestamp')
      echo "Restoring from: $timestamp"
      echo "$saved" | jq -r '.running[]' 2>/dev/null | while read svc; do
        echo -n "  Starting $svc... "
        cmd_start "$svc" 2>/dev/null
        echo -e "${GREEN}done${NC}"
      done
      echo -e "${GREEN}Restore complete${NC}"
      ;;

    *)
      echo "Usage: golems services [list|snapshot|restore]"
      echo "  list       Show all service status (default)"
      echo "  snapshot   Save current running services state"
      echo "  restore    Restart services from last snapshot"
      ;;
  esac
}

cmd_docker() {
  echo -e "${BLUE}=== DOCKER CONTAINERS ===${NC}"
  docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null | grep -E "NAME|ollama"

  echo
  echo -e "${BLUE}Health Check:${NC}"
  docker inspect ollama-sandbox --format='{{range .State.Health.Log}}{{.End}}: {{.ExitCode}} - {{.Output}}{{end}}' 2>/dev/null | tail -3
}

cmd_sessions() {
  case "${1:-active}" in
    active|"")
      echo -e "${BLUE}=== ACTIVE CLAUDE SESSIONS ===${NC}"
      cd "$GOLEMS_HOME" && bun -e "
        import { getActiveSessions, formatActiveSessions } from '@golems/shared/lib/session-registry';
        console.log(formatActiveSessions(getActiveSessions()));
      "
      ;;
    registry|list)
      echo -e "${BLUE}=== REPO SESSION REGISTRY ===${NC}"
      cd "$GOLEMS_HOME" && bun -e "
        import { resolveRepoPaths, formatRegistry } from '@golems/shared/lib/session-registry';
        console.log(formatRegistry(resolveRepoPaths('$HOME/Gits')));
      "
      ;;
    spawn)
      local repo="${2:-golems}"
      echo -e "${BLUE}Spawning session for: ${repo}${NC}"
      cd "$GOLEMS_HOME" && bun -e "
        import { getRepoSession, setRepoTabTitle } from '@golems/shared/lib/session-registry';
        const session = getRepoSession('${repo}');
        if (!session) { console.error('Unknown repo: ${repo}'); process.exit(1); }
        setRepoTabTitle('${repo}');
        console.log(JSON.stringify({
          repo: session.repo,
          sessionName: session.sessionName,
          personality: session.personality,
          command: 'claude --resume ' + session.sessionName + ' -c',
        }, null, 2));
      "
      ;;
    *)
      echo "Usage: golems sessions [active|registry|spawn <repo>]"
      echo ""
      echo "  active     Show running Claude sessions (default)"
      echo "  registry   Show all repo session configs"
      echo "  spawn      Show spawn command for a repo"
      ;;
  esac
}

cmd_logs() {
  local name="${1:-telegram}"
  local svc="$(_svc_name "$name")"

  if [ -z "$svc" ]; then
    echo "Unknown service: $name"
    echo "Available: telegram, nightshift, ollama, job-golem, email-golem, briefing, session-archiver, storage-cleanup"
    return 1
  fi

  local logfile="$(_svc_log "$svc")"

  if [ -f "$logfile" ]; then
    tail -f "$logfile"
  else
    # Fallback: check /tmp for legacy logs
    local legacy_log="/tmp/golemszikaron-${svc}.log"
    if [ -f "$legacy_log" ]; then
      echo "(legacy log at $legacy_log — will use $logfile after next restart)"
      tail -f "$legacy_log"
    else
      echo "No logs found at $logfile"
      echo "Is $svc running? Check: golems status"
    fi
  fi
}

# Resolve service alias to canonical name
_svc_name() {
  case "$1" in
    telegram|bot)          echo "telegram" ;;
    nightshift)            echo "nightshift" ;;
    ollama)                echo "ollama" ;;
    job-golem|job)         echo "job-golem" ;;
    email-golem|email)     echo "email-golem" ;;
    briefing)              echo "briefing" ;;
    session-archiver|archiver) echo "session-archiver" ;;
    storage-cleanup|cleanup)   echo "storage-cleanup" ;;
    bedtime-guardian|bedtime)   echo "bedtime-guardian" ;;
    comfyui|comfy)         echo "comfyui" ;;
    render-service|render) echo "render-service" ;;
    *) echo "" ;;
  esac
}

# Resolve service name to launchd label
_svc_label() {
  case "$1" in
    session-archiver)  echo "com.golems.session-archiver" ;;
    bedtime-guardian)   echo "com.golems.bedtime-guardian" ;;
    storage-cleanup)   echo "com.golems.storage-cleanup" ;;
    comfyui)           echo "com.golems.comfyui" ;;
    render-service)    echo "com.golems.render-service" ;;
    *)                 echo "com.golemszikaron.$1" ;;
  esac
}

# Resolve service name to log file path
_svc_log() {
  echo "$LOGS_DIR/$1.log"
}

# Resolve service name to plist path
_svc_plist() {
  echo "$HOME/Library/LaunchAgents/$(_svc_label "$1").plist"
}

cmd_start() {
  local svc="$(_svc_name "$1")"
  if [ -z "$svc" ]; then
    echo "Unknown service: $1"
    echo "Available: telegram, nightshift, ollama, job-golem, email-golem, briefing, session-archiver, storage-cleanup"
    return 1
  fi

  local label="$(_svc_label "$svc")"
  local plist="$(_svc_plist "$svc")"

  # Ensure logs dir exists
  mkdir -p "$LOGS_DIR"

  if ! [ -f "$plist" ]; then
    echo "Plist not found: $plist"
    return 1
  fi

  launchctl bootstrap gui/$(id -u) "$plist" 2>/dev/null || true
  echo "Started $svc"
}

cmd_stop() {
  local svc="$(_svc_name "$1")"
  if [ -z "$svc" ]; then
    echo "Unknown service: $1"
    return 1
  fi

  local label="$(_svc_label "$svc")"

  # Unload from launchd (prevents auto-respawn)
  launchctl bootout gui/$(id -u)/$label 2>/dev/null || true

  # For telegram: also ensure port 3847 is freed
  if [ "$svc" = "telegram" ]; then
    for i in 1 2 3 4 5; do
      local pid=$(lsof -ti:3847 2>/dev/null)
      [ -z "$pid" ] && break
      kill -9 $pid 2>/dev/null || true
      sleep 1
    done
  fi

  echo "Stopped $svc"
}

cmd_restart() {
  local svc="$(_svc_name "$1")"
  if [ -z "$svc" ]; then
    echo "Unknown service: $1"
    return 1
  fi

  cmd_stop "$svc"
  sleep 2
  cmd_start "$svc"
}

cmd_scrape() {
  echo "Triggering job scrape..."
  if curl --fail -s http://localhost:3847/scrape-jobs; then
    echo ""
    echo "Scrape started. Check: golems logs telegram"
  else
    echo ""
    echo -e "${RED}Failed to trigger job scrape.${NC} Is telegram bot running?"
    echo "Start with: golems start telegram"
    exit 1
  fi
}

cmd_clear_errors() {
  echo "Clearing launchd error states..."
  for label in com.golemszikaron.job-golem com.golemszikaron.email-golem com.golemszikaron.ollama com.golems.session-archiver com.golems.storage-cleanup; do
    launchctl bootout gui/$(id -u)/$label 2>/dev/null || true
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/${label}.plist 2>/dev/null || true
  done
  echo "Done. Check: golems services"
}

# All core services (for on/off/latest)
CORE_SERVICES="telegram job-golem email-golem ollama"
SCHEDULED_SERVICES="nightshift briefing session-archiver storage-cleanup bedtime-guardian"

cmd_latest() {
  echo -e "${BLUE}=== DEPLOYING LATEST CODE ===${NC}"
  echo "Restarting all services to pick up code changes..."
  echo

  for svc in $CORE_SERVICES; do
    [ "$svc" = "ollama" ] && continue
    local label="$(_svc_label "$svc")"
    echo -n "  Restarting $svc... "
    if launchctl kickstart -k gui/$(id -u)/$label 2>/dev/null; then
      echo -e "${GREEN}done${NC}"
    else
      # Not running — try full restart
      cmd_restart "$svc" >/dev/null 2>&1
      echo -e "${YELLOW}reloaded${NC}"
    fi
  done

  echo
  echo -e "${GREEN}✓ All services restarted with latest code${NC}"
  echo "  Check status: golems status"
}

cmd_on() {
  echo -e "${BLUE}=== WAKING UP GOLEMS ===${NC}"
  echo "Starting all services..."
  echo

  # Start core services
  for svc in $CORE_SERVICES; do
    echo -n "  Starting $svc... "
    cmd_start "$svc" 2>/dev/null && echo -e "${GREEN}done${NC}" || echo -e "${YELLOW}already running${NC}"
  done

  # Load scheduled services
  for svc in $SCHEDULED_SERVICES; do
    echo -n "  Loading $svc... "
    cmd_start "$svc" 2>/dev/null
  done

  echo

  # Verify all services actually loaded
  local failed=0
  for svc in job-golem email-golem; do
    if ! launchctl list 2>/dev/null | grep -q "com.golemszikaron.$svc"; then
      echo -e "  ${RED}WARNING: $svc failed to load!${NC}"
      echo "  Try: launchctl load ~/Library/LaunchAgents/com.golemszikaron.$svc.plist"
      failed=1
    fi
  done
  for svc in session-archiver storage-cleanup; do
    if ! launchctl list 2>/dev/null | grep -q "com.golems.$svc"; then
      echo -e "  ${RED}WARNING: $svc failed to load!${NC}"
      echo "  Try: launchctl load ~/Library/LaunchAgents/com.golems.$svc.plist"
      failed=1
    fi
  done

  if [ $failed -eq 0 ]; then
    echo -e "${GREEN}✓ All golems are awake${NC}"
  else
    echo -e "${YELLOW}⚠ Some services failed — check above${NC}"
  fi
  cmd_status
}

cmd_off() {
  echo -e "${BLUE}=== HIBERNATING GOLEMS ===${NC}"
  echo "Stopping all services..."
  echo

  # Stop core services
  for svc in $CORE_SERVICES; do
    echo -n "  Stopping $svc... "
    cmd_stop "$svc" 2>/dev/null
    echo -e "${GREEN}done${NC}"
  done

  # Unload scheduled services
  for svc in $SCHEDULED_SERVICES; do
    echo -n "  Unloading $svc... "
    cmd_stop "$svc" 2>/dev/null
    echo -e "${GREEN}done${NC}"
  done

  # Kill any lingering Claude sessions
  pkill -f "claude " 2>/dev/null || true

  echo
  echo -e "${YELLOW}💤 All golems are hibernating${NC}"
  echo "  Wake up with: golems on"
}

CHAT_DIR="$HOME/Gits/golems/contexts/claude-chat"

cmd_instructions() {
  local golem="$1"
  echo -e "${BLUE}=== CLAUDE CHAT PROJECT FILES ===${NC}"
  echo
  echo "Upload these files to your claude.ai projects:"
  echo

  if [ -n "$golem" ]; then
    # Show specific golem
    local file="$CHAT_DIR/${golem}.md"
    if [ -f "$file" ]; then
      echo -e "  ${GREEN}$file${NC}"
      echo
      echo "--- Content Preview ---"
      head -20 "$file"
      echo "..."
      echo
      echo -e "Copy to clipboard: ${YELLOW}cat $file | pbcopy${NC}"
    else
      echo -e "${RED}No instructions for: $golem${NC}"
      echo "Available:"
      ls "$CHAT_DIR"/*.md 2>/dev/null | grep -v README | xargs -I{} basename {} .md | sed 's/^/  /'
    fi
  else
    # List all
    for file in "$CHAT_DIR"/*.md; do
      [ "$(basename "$file")" = "README.md" ] && continue
      local name=$(basename "$file" .md)
      local updated=$(grep "Last updated" "$file" 2>/dev/null | head -1 | sed 's/.*: //')
      printf "  %-25s %s\n" "$name" "(updated: ${updated:-unknown})"
    done
    echo
    echo -e "Upload to claude.ai → Projects → [golem name] → Add files"
    echo -e "Always include ${YELLOW}style-card.md${NC} alongside golem instructions."
    echo
    echo -e "Details: ${YELLOW}golems instructions <golem-name>${NC}"
    echo -e "Regenerate style card: ${YELLOW}golems regen-style${NC}"
  fi
}

cmd_cloud() {
  local RAILWAY_URL="${RAILWAY_URL:-https://golems-cloud.up.railway.app}"
  echo -e "${BLUE}=== RAILWAY CLOUD WORKER ===${NC}"
  echo -e "Endpoint: ${YELLOW}${RAILWAY_URL}${NC}"
  echo

  # Health check
  echo -e "${BLUE}Health:${NC}"
  local health
  health=$(curl -s --max-time 5 "${RAILWAY_URL}/health" 2>/dev/null)
  if [ $? -eq 0 ] && [ -n "$health" ]; then
    local status=$(echo "$health" | jq -r '.status // "unknown"')
    local uptime=$(echo "$health" | jq -r '.uptime // "?"')
    local backend=$(echo "$health" | jq -r '.backend // "?"')
    local state_backend=$(echo "$health" | jq -r '.stateBackend // "?"')
    local tg_mode=$(echo "$health" | jq -r '.telegramMode // "?"')

    if [ "$status" = "ok" ]; then
      echo -e "  $(status_icon 0) Status: ${GREEN}ok${NC}"
    else
      echo -e "  $(status_icon 1) Status: ${RED}${status}${NC}"
    fi
    echo "  Uptime: ${uptime}s"
    echo "  LLM Backend: ${backend}"
    echo "  State Backend: ${state_backend}"
    echo "  Telegram Mode: ${tg_mode}"
  else
    echo -e "  $(status_icon 1) ${RED}Not responding${NC}"
    return 1
  fi

  echo

  # Usage stats
  echo -e "${BLUE}Usage:${NC}"
  local usage
  usage=$(curl -s --max-time 5 "${RAILWAY_URL}/usage" 2>/dev/null)
  if [ $? -eq 0 ] && [ -n "$usage" ]; then
    local total_calls=$(echo "$usage" | jq -r '.totalCalls // 0')
    local total_input=$(echo "$usage" | jq -r '.totalInputTokens // 0')
    local total_output=$(echo "$usage" | jq -r '.totalOutputTokens // 0')
    local total_cost=$(echo "$usage" | jq -r '.totalCostUsd // 0')

    echo "  Total Calls: ${total_calls}"
    echo "  Input Tokens: ${total_input}"
    echo "  Output Tokens: ${total_output}"
    echo -e "  Cost: ${YELLOW}\$${total_cost}${NC}"

    # Show by-source breakdown if available
    local sources=$(echo "$usage" | jq -r '.bySource // empty | keys[]' 2>/dev/null)
    if [ -n "$sources" ]; then
      echo
      echo -e "${BLUE}By Source:${NC}"
      echo "$sources" | while read src; do
        local src_calls=$(echo "$usage" | jq -r ".bySource[\"$src\"].calls // 0")
        local src_cost=$(echo "$usage" | jq -r ".bySource[\"$src\"].costUsd // 0")
        printf "  %-20s %s calls  \$%s\n" "$src" "$src_calls" "$src_cost"
      done
    fi
  else
    echo "  (Could not fetch usage data)"
  fi
}

cmd_regen_style() {
  local subcmd="${1:-v2}"
  case "$subcmd" in
    v1)
      echo "Regenerating style card v1 from Zikaron data..."
      cd "$GOLEMS_HOME" && bun packages/shared/src/lib/style-export.ts "$CHAT_DIR/style-card.md"
      echo -e "${GREEN}✓ Style card v1 updated${NC}"
      echo "  Re-upload to your claude.ai projects."
      ;;
    v2|build)
      echo "Building style profiles v2 from Zikaron..."
      cd "$GOLEMS_HOME" && bun scripts/build-style-profiles.ts
      ;;
    show)
      local card="${HOME}/.golems-zikaron/style/style-card-v2.md"
      if [ -f "$card" ]; then
        cat "$card"
      else
        echo "No style card found. Run: golems style build"
      fi
      ;;
    *)
      echo "Usage: golems style [v2|v1|build|show]"
      echo "  v2/build  Build per-context profiles from Zikaron (default)"
      echo "  v1        Legacy single-file style card"
      echo "  show      Display current style card"
      ;;
  esac
}

# Main
case "${1:-status}" in
  help|--help|-h)
    cmd_help
    ;;
  status)
    cmd_status
    ;;
  tui|dashboard)
    echo -e "${BLUE}=== GOLEMS DASHBOARD ===${NC}"
    cd "$GOLEMS_HOME" && bun -e "
      import { getSystemHealth, formatDashboard } from '@golems/shared/lib/tui';
      const health = getSystemHealth();
      console.log(formatDashboard(health));
    "
    ;;
  doctor)
    cd "$GOLEMS_HOME" && bun run packages/services/src/doctor.ts
    ;;
  services|svc)
    cmd_services "$2"
    ;;
  scrape)
    cmd_scrape
    ;;
  sessions)
    cmd_sessions "$2" "$3"
    ;;
  logs)
    cmd_logs "$2"
    ;;
  start)
    cmd_start "$2"
    ;;
  stop)
    cmd_stop "$2"
    ;;
  restart)
    cmd_restart "$2"
    ;;
  reload)
    # Reload delegates to restart for code consistency
    cmd_restart "${2:-telegram}"
    echo "Reloaded ${2:-telegram}"
    ;;
  clear-errors|clear)
    cmd_clear_errors
    ;;
  latest|deploy)
    cmd_latest
    ;;
  on|wake|up)
    cmd_on
    ;;
  off|hibernate|sleep)
    cmd_off
    ;;
  instructions|instr)
    cmd_instructions "$2"
    ;;
  cloud|railway)
    cmd_cloud
    ;;
  helpers)
    cd "$GOLEMS_HOME" && bun run packages/services/src/helpers-status.ts "${@:2}"
    ;;
  skills)
    cd "$GOLEMS_HOME" && bun run packages/services/src/skills-list.ts "${@:2}"
    ;;
  autopilot)
    ENABLE_FILE="$HOME/.claude/hooks/keep-going.enabled"
    case "${2:-status}" in
      on)
        touch "$ENABLE_FILE"
        echo -e "${GREEN}Autopilot ON${NC} — Claude will keep working until plan is done"
        echo "Disable with: golems autopilot off"
        ;;
      off)
        rm -f "$ENABLE_FILE"
        echo -e "${YELLOW}Autopilot OFF${NC} — Claude will stop normally"
        ;;
      status|"")
        if [ -f "$ENABLE_FILE" ]; then
          echo -e "${GREEN}● Autopilot is ON${NC}"
        else
          echo -e "${GRAY}○ Autopilot is OFF${NC}"
        fi
        ;;
    esac
    ;;
  enrich)
    bash "$GOLEMS_HOME/scripts/enrich.sh" "${2:-status}" "${3:-}"
    ;;
  regen-style|style)
    cmd_regen_style "${2:-v2}"
    ;;
  setup|wizard)
    case "${2:-interactive}" in
      check)
        echo -e "${BLUE}=== WIRING CHECK ===${NC}"
        cd "$GOLEMS_HOME" && bun -e "
          import { runWiringChecks, formatWiringReport, logWiringErrors } from '@golems/shared/lib/wizard-state';
          const checks = runWiringChecks({ checkHelpers: true, checkServices: ${3:-false} });
          console.log(formatWiringReport(checks));
          const newErrors = logWiringErrors(checks);
          if (newErrors.length > 0) {
            console.log('\nNew errors logged: ' + newErrors.length);
          }
        "
        ;;
      status)
        echo -e "${BLUE}=== WIZARD STATUS ===${NC}"
        cd "$GOLEMS_HOME" && bun -e "
          import { loadState, formatStateReport, getUnresolvedErrors } from '@golems/shared/lib/wizard-state';
          const state = loadState();
          console.log(formatStateReport(state));
          const errors = getUnresolvedErrors();
          if (errors.length > 0) {
            console.log('\nUnresolved wiring errors: ' + errors.length);
            for (const e of errors) {
              console.log('  [' + e.category + '] ' + e.repo + ': ' + e.message);
              if (e.suggestedFix) console.log('    Fix: ' + e.suggestedFix);
            }
          }
        "
        ;;
      continue|-c)
        echo -e "${BLUE}=== WIZARD (continue mode) ===${NC}"
        cd "$GOLEMS_HOME" && bun -e "
          import { loadState, getPendingSteps, formatStateReport } from '@golems/shared/lib/wizard-state';
          const state = loadState();
          const pending = getPendingSteps(state);
          if (pending.length === 0) {
            console.log('All wizard steps completed!');
          } else {
            console.log('Pending steps:');
            for (const s of pending) {
              console.log('  [ ] ' + s.name);
            }
            console.log('\nRun golems wizard to complete remaining steps.');
          }
        "
        ;;
      add-project)
        if [ -z "$3" ]; then
          echo "Usage: golems wizard add-project <path>"
          exit 1
        fi
        REPO_PATH="$(cd "$3" 2>/dev/null && pwd || echo "$3")"
        REPO_NAME="$(basename "$REPO_PATH")"
        echo -e "${BLUE}=== WIRE REPO: $REPO_NAME ===${NC}"
        cd "$GOLEMS_HOME" && bun -e "
          import { loadState, saveState, wireRepo, checkRepoClaudeMd, checkRepoMcpConfig, checkRepoSkillsDir, checkRepoRules } from '@golems/shared/lib/wizard-state';
          const state = loadState();
          const repo = wireRepo(state, '$REPO_PATH', '$REPO_NAME');
          saveState(state);
          console.log('Wired: ' + repo.name);
          console.log('  CLAUDE.md: ' + (repo.hasClaudeMd ? 'YES' : 'MISSING'));
          console.log('  .mcp.json: ' + (repo.hasMcpConfig ? 'YES' : 'MISSING'));
          console.log('  Skills:    ' + (repo.hasSkills ? 'YES' : 'MISSING'));
          const rulesCheck = checkRepoRules('$REPO_PATH', '$REPO_NAME');
          console.log('  Rules:     ' + (rulesCheck.passed ? 'YES' : rulesCheck.message));
          const checks = [
            checkRepoClaudeMd('$REPO_PATH', '$REPO_NAME'),
            checkRepoMcpConfig('$REPO_PATH', '$REPO_NAME'),
            checkRepoSkillsDir('$REPO_PATH', '$REPO_NAME'),
            rulesCheck,
          ];
          const issues = checks.filter(c => !c.passed);
          if (issues.length > 0) {
            console.log('\nIssues to fix:');
            for (const c of issues) {
              console.log('  - ' + c.message);
              if (c.suggestedFix) console.log('    Fix: ' + c.suggestedFix);
            }
          }
        "
        ;;
      interactive|"")
        echo -e "${BLUE}=== GOLEMS SETUP WIZARD ===${NC}"
        cd "$GOLEMS_HOME" && bun run packages/services/src/wizard.ts
        ;;
      *)
        echo "Usage: golems wizard [check|status|continue|add-project <path>]"
        echo ""
        echo "Subcommands:"
        echo "  check          Run wiring checks on all repos"
        echo "  status         Show wizard state (completed steps, repos, errors)"
        echo "  continue       Show pending wizard steps"
        echo "  add-project    Wire a new repo into golems"
        echo "  (no subcommand) Run interactive setup wizard"
        ;;
    esac
    ;;
  update)
    echo -e "${BLUE}=== GOLEMS UPDATE ===${NC}"
    cd "$GOLEMS_HOME" && bun -e "
      import { runUpdate, formatUpdateReport, saveUpdateHistory } from '@golems/shared/lib/self-update';
      const repoPath = '$HOME/Gits/golems';
      const report = runUpdate(repoPath);
      console.log(formatUpdateReport(report));
      saveUpdateHistory(report);
    "
    ;;
  version)
    cd "$GOLEMS_HOME" && bun -e "
      import { getVersionInfo } from '@golems/shared/lib/self-update';
      const info = getVersionInfo('$HOME/Gits/golems');
      console.log('golems ' + info.version + ' (' + info.commit + ')');
      console.log('branch: ' + info.branch);
      console.log('date: ' + info.date);
    "
    ;;
  queue)
    case "${2:-list}" in
      list|"")
        cd "$GOLEMS_HOME" && bun -e "
          import { loadQueue, formatQueueSummary } from '@golems/claude/lib/chat-queue';
          const q = loadQueue();
          console.log(formatQueueSummary(q));
        "
        ;;
      add)
        if [ -z "$3" ]; then
          echo "Usage: golems queue add \"message\" [type] [source]"
          exit 1
        fi
        cd "$GOLEMS_HOME" && bun -e "
          import { loadQueue, saveQueue, enqueue } from '@golems/claude/lib/chat-queue';
          const q = loadQueue();
          const item = enqueue(q, '$3', '${4:-chat}', '${5:-cli}');
          saveQueue(q);
          console.log('Queued: ' + item.id);
        "
        ;;
      remove)
        if [ -z "$3" ]; then
          echo "Usage: golems queue remove <id>"
          exit 1
        fi
        cd "$GOLEMS_HOME" && bun -e "
          import { loadQueue, saveQueue, dequeue } from '@golems/claude/lib/chat-queue';
          const q = loadQueue();
          const item = dequeue(q, '$3');
          if (item) {
            saveQueue(q);
            console.log('Removed: ' + item.id);
          } else {
            console.log('Item not found: $3');
          }
        "
        ;;
      clean)
        cd "$GOLEMS_HOME" && bun -e "
          import { loadQueue, saveQueue, cleanOld } from '@golems/claude/lib/chat-queue';
          const q = loadQueue();
          const removed = cleanOld(q, ${3:-7});
          saveQueue(q);
          console.log('Cleaned ' + removed + ' old items');
        "
        ;;
      *)
        echo "Usage: golems queue [list|add|remove|clean]"
        ;;
    esac
    ;;
  e2e)
    echo -e "${BLUE}=== E2E TESTS ===${NC}"
    cd "$HOME/Gits/golems/packages/e2e" && npx playwright test "${@:2}"
    ;;
  costs)
    COST_LOG="$HOME/.golems-zikaron/api_costs.jsonl"
    case "${2:-summary}" in
      summary|"")
        echo -e "${BLUE}=== API COSTS ===${NC}"
        cd "$GOLEMS_HOME" && bun -e "
          import { readCostLog, filterByPeriod, summarize, formatSummary } from '@golems/shared/lib/cost-tracker';
          const entries = readCostLog('$COST_LOG');
          const periods = ['today', 'week', 'month', 'all'];
          for (const p of periods) {
            const filtered = filterByPeriod(entries, p);
            console.log(formatSummary(summarize(filtered, p)));
            console.log('');
          }
        "
        ;;
      by-source)
        echo -e "${BLUE}=== COSTS BY SOURCE ===${NC}"
        cd "$GOLEMS_HOME" && bun -e "
          import { readCostLog, filterByPeriod, groupBySource, formatBySource } from '@golems/shared/lib/cost-tracker';
          const entries = readCostLog('$COST_LOG');
          const period = '${3:-all}';
          const filtered = filterByPeriod(entries, period);
          console.log('Period: ' + period);
          console.log(formatBySource(groupBySource(filtered)));
        "
        ;;
      by-model)
        echo -e "${BLUE}=== COSTS BY MODEL ===${NC}"
        cd "$GOLEMS_HOME" && bun -e "
          import { readCostLog, filterByPeriod, groupByModel, formatByModel } from '@golems/shared/lib/cost-tracker';
          const entries = readCostLog('$COST_LOG');
          const period = '${3:-all}';
          const filtered = filterByPeriod(entries, period);
          console.log('Period: ' + period);
          console.log(formatByModel(groupByModel(filtered)));
        "
        ;;
      daily)
        echo -e "${BLUE}=== DAILY BREAKDOWN ===${NC}"
        cd "$GOLEMS_HOME" && bun -e "
          import { readCostLog, groupByDay, formatDaily } from '@golems/shared/lib/cost-tracker';
          const entries = readCostLog('$COST_LOG');
          console.log(formatDaily(groupByDay(entries)));
        "
        ;;
      log)
        if [ -f "$COST_LOG" ]; then
          echo -e "${BLUE}=== RECENT COST LOG ===${NC}"
          tail -20 "$COST_LOG" | while IFS= read -r line; do
            echo "$line" | bun -e "
              const line = await Bun.stdin.text();
              const e = JSON.parse(line.trim());
              const d = new Date(e.timestamp).toLocaleString('en-IL', {timeZone:'Asia/Jerusalem'});
              console.log(d + '  ' + e.source.padEnd(20) + '  \$' + e.cost_usd.toFixed(6));
            " 2>/dev/null || echo "$line"
          done
        else
          echo "No cost log found at $COST_LOG"
        fi
        ;;
      *)
        echo "Usage: golems costs [summary|by-source|by-model|daily|log]"
        echo ""
        echo "  summary            Overview by period (default)"
        echo "  by-source [period] Breakdown by source (today/week/month/all)"
        echo "  by-model [period]  Breakdown by model"
        echo "  daily              Day-by-day cost chart"
        echo "  log                Recent raw entries"
        ;;
    esac
    ;;
  maintain|maintenance)
    echo -e "${BLUE}=== MAINTENANCE CHECK ===${NC}"
    cd "$GOLEMS_HOME" && bun -e "
      import { runMaintenanceChecks, formatReport } from '@golems/shared/lib/maintainer-golem';
      const report = runMaintenanceChecks({
        reposPath: '$HOME/Gits',
        stateDir: '$HOME/.golems-zikaron',
        configPath: '$HOME/.golems/config.yaml',
      });
      console.log(formatReport(report));
    "
    ;;
  config)
    case "${2:-show}" in
      init)
        cd "$GOLEMS_HOME" && bun -e 'import { initConfig } from "./src/lib/config"; console.log(initConfig())'
        ;;
      show|"")
        if [ -f "$HOME/.golems/config.yaml" ]; then
          cat "$HOME/.golems/config.yaml"
        else
          echo "No config file found. Run 'golems config init' to create one."
        fi
        ;;
      path)
        echo "$HOME/.golems/config.yaml"
        ;;
      edit)
        ${EDITOR:-vim} "$HOME/.golems/config.yaml"
        ;;
    esac
    ;;
  mascot)
    case "${2:---color}" in
      --plain)
        cd "$GOLEMS_HOME" && bun -e "
          import { getGuardianPlain } from '@golems/shared/lib/ascii-mascots';
          console.log(getGuardianPlain());
        "
        ;;
      --simple)
        cd "$GOLEMS_HOME" && bun -e "
          import { renderGuardianAnsi } from '@golems/shared/lib/ascii-mascots';
          console.log(renderGuardianAnsi({ variant: 'simple' }).join('\n'));
        "
        ;;
      --color|"")
        cd "$GOLEMS_HOME" && bun -e "
          import { formatSplash } from '@golems/shared/lib/ascii-mascots';
          console.log(formatSplash());
        "
        ;;
      *)
        echo "Usage: golems mascot [--color|--plain|--simple]"
        exit 1
        ;;
    esac
    ;;
  sweep|quality)
    cd "$GOLEMS_HOME" && bun -e "
      import { runSweep, formatSweepReport } from '@golems/shared/lib/quality-sweep';
      const pkgDir = '${2:-$GOLEMS_HOME}';
      const report = runSweep(pkgDir, '$HOME/Gits/golems');
      console.log(formatSweepReport(report));
    "
    ;;
  i18n|locale)
    case "${2:-info}" in
      info|"")
        cd "$GOLEMS_HOME" && bun -e "
          import { formatLocaleInfo, detectLocale } from '@golems/shared/lib/i18n';
          console.log(formatLocaleInfo(detectLocale()));
        "
        ;;
      set)
        if [ -z "$3" ]; then
          echo "Usage: golems i18n set <en|he>"
          exit 1
        fi
        cd "$GOLEMS_HOME" && bun -e "
          import { setLocale, formatLocaleInfo } from '@golems/shared/lib/i18n';
          setLocale('$3');
          console.log(formatLocaleInfo('$3'));
        "
        ;;
      keys)
        cd "$GOLEMS_HOME" && bun -e "
          import { getTranslationKeys, getTranslationCount } from '@golems/shared/lib/i18n';
          console.log('Translation keys: ' + getTranslationCount());
          for (const k of getTranslationKeys()) console.log('  ' + k);
        "
        ;;
      help)
        cat << 'I18N_EOF'
golems i18n — Internationalization info

  golems i18n              Show current locale info
  golems i18n set <locale> Set locale (en or he)
  golems i18n keys         List all translation keys
  golems i18n help         This help
I18N_EOF
        ;;
      *)
        echo "Unknown i18n command: $2"
        echo "Run 'golems i18n help' for usage"
        exit 1
        ;;
    esac
    ;;
  explore)
    case "${2:-status}" in
      status|"")
        cd "$GOLEMS_HOME" && bun -e "
          import { loadState, formatStateOverview } from '@golems/shared/lib/exploration';
          console.log(formatStateOverview(loadState()));
        "
        ;;
      templates)
        cd "$GOLEMS_HOME" && bun -e "
          import { EXPLORATION_TEMPLATES } from '@golems/shared/lib/exploration';
          for (const t of EXPLORATION_TEMPLATES) {
            console.log('  ' + t.name.padEnd(24) + t.description);
          }
        "
        ;;
      latest)
        cd "$GOLEMS_HOME" && bun -e "
          import { loadState, getLatestSession, formatSessionSummary } from '@golems/shared/lib/exploration';
          const s = loadState();
          const session = getLatestSession(s);
          if (!session) { console.log('No explorations yet.'); process.exit(0); }
          console.log(formatSessionSummary(session));
        "
        ;;
      agents)
        cd "$GOLEMS_HOME" && bun -e "
          import { getAvailableAgents } from '@golems/shared/lib/exploration';
          const agents = getAvailableAgents();
          if (agents.length === 0) { console.log('No agents available.'); process.exit(0); }
          console.log('Available agents: ' + agents.join(', '));
        "
        ;;
      help)
        cat << 'EXPLORE_EOF'
golems explore — Codebase exploration with CLI agents

  golems explore              Show exploration status
  golems explore templates    List exploration templates
  golems explore agents       Show available CLI agents
  golems explore latest       Show latest session details
  golems explore help         This help
EXPLORE_EOF
        ;;
      *)
        echo "Unknown explore command: $2"
        echo "Run 'golems explore help' for usage"
        exit 1
        ;;
    esac
    ;;
  index-whatsapp)
    cd "$GOLEMS_HOME" && bun run packages/services/src/whatsapp-index-cli.ts "${@:2}"
    ;;
  rules)
    RULES_LIB="$GOLEMS_HOME/rules-library"
    case "${2:-check}" in
      check)
        TARGET="${3:-.}"
        TARGET="$(cd "$TARGET" 2>/dev/null && pwd || echo "$TARGET")"
        REPO_NAME="$(basename "$TARGET")"
        echo -e "${BLUE}=== RULES CHECK: $REPO_NAME ===${NC}"

        # Check for @context references in CLAUDE.md
        if [ -f "$TARGET/CLAUDE.md" ]; then
          CONTEXTS=$(grep '^@context:' "$TARGET/CLAUDE.md" 2>/dev/null | sed 's/@context: *//')
          if [ -n "$CONTEXTS" ]; then
            echo -e "${YELLOW}⚠  Found @context: references (deprecated):${NC}"
            while IFS= read -r ctx; do
              if [ -f "$RULES_LIB/$ctx.md" ]; then
                echo -e "  ${GREEN}✅${NC} $ctx.md — available in rules-library"
              else
                echo -e "  ${RED}❌${NC} $ctx.md — MISSING from rules-library"
              fi
            done <<< "$CONTEXTS"
            echo ""
            echo "Migrate: copy rules to $TARGET/.claude/rules/ and remove @context: lines"
          fi
        fi

        # Check .claude/rules/ if it exists
        if [ -d "$TARGET/.claude/rules" ]; then
          RULE_COUNT=$(find "$TARGET/.claude/rules" -maxdepth 1 -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ')
          echo -e "${GREEN}✅${NC} .claude/rules/ exists ($RULE_COUNT rules)"
          for f in "$TARGET/.claude/rules/"*.md; do
            [ -f "$f" ] || continue
            NAME=$(basename "$f")
            HAS_GLOBS=$(head -5 "$f" | grep -c 'globs:' || true)
            if [ "$HAS_GLOBS" -gt 0 ]; then
              GLOB_VAL=$(head -5 "$f" | grep 'globs:' | sed 's/globs: *//')
              echo -e "  📄 $NAME ${GRAY}(globs: $GLOB_VAL)${NC}"
            else
              echo -e "  📄 $NAME ${GRAY}(always loaded)${NC}"
            fi
          done
        else
          echo -e "${YELLOW}○${NC} No .claude/rules/ directory"
        fi
        ;;
      list)
        echo -e "${BLUE}=== RULES LIBRARY ===${NC}"
        echo "Path: $RULES_LIB"
        echo ""
        while IFS= read -r f; do
          [ -f "$f" ] || continue
          REL="${f#$RULES_LIB/}"
          echo "  📄 $REL"
        done < <(find "$RULES_LIB" -name '*.md' -type f | sort)
        ;;
      export)
        TARGET="${4:-.}"
        RULE="${3}"
        if [ -z "$RULE" ]; then
          echo "Usage: golems rules export <rule-name> [target-repo]"
          echo "Example: golems rules export tech/react-native ~/Gits/domica"
          exit 1
        fi
        TARGET="$(cd "$TARGET" 2>/dev/null && pwd || echo "$TARGET")"
        SRC="$RULES_LIB/$RULE.md"
        DEST="$TARGET/.claude/rules/$(basename "$RULE").md"
        if [ ! -f "$SRC" ]; then
          echo -e "${RED}❌ Rule not found: $RULE${NC}"
          echo "Run 'golems rules list' to see available rules"
          exit 1
        fi
        mkdir -p "$TARGET/.claude/rules"
        cp "$SRC" "$DEST"
        echo -e "${GREEN}✅${NC} Exported $RULE → $DEST"
        ;;
      help)
        cat << 'RULES_EOF'
golems rules — Manage Claude Code rules across projects

  golems rules                    Check current dir for rule status
  golems rules check [path]       Check a repo's rules (default: .)
  golems rules list               List all rules in the library
  golems rules export <rule> [path]  Copy a rule to a project's .claude/rules/

Examples:
  golems rules check ~/Gits/domica
  golems rules export tech/react-native ~/Gits/domica
  golems rules export workflow/rtl ~/Gits/domica
RULES_EOF
        ;;
      *)
        echo "Unknown rules command: $2"
        echo "Run 'golems rules help' for usage"
        exit 1
        ;;
    esac
    ;;
  *)
    echo "Unknown command: $1"
    echo "Run 'golems help' for usage"
    exit 1
    ;;
esac
