#!/usr/bin/env bash
#
# golems - System status and control CLI
# Usage: golems [command]
#

set -e

GOLEMS_HOME="${GOLEMS_HOME:-$HOME/Gits/golems/packages/autonomous}"
LOGS_DIR="$HOME/.golems-zikaron/logs"
STATE_FILE="$HOME/.golems-zikaron/state.json"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

status_icon() {
  case "$1" in
    0) echo -e "${GREEN}✓${NC}" ;;
    1) echo -e "${RED}✗${NC}" ;;
    *) echo -e "${YELLOW}?${NC}" ;;
  esac
}

cmd_help() {
  cat << 'EOF'
golems - Golem System CLI

USAGE:
  golems [command]

COMMANDS:
  status        Show all services status (default)
  services      Detailed launchd service status
  scrape        Trigger job scrape now
  sessions      Running Claude sessions
  logs [name]   Show logs (telegram, nightshift, job-golem, etc.)

  start [svc]   Start a service (telegram, nightshift, ollama)
  stop [svc]    Stop a service
  restart [svc] Restart a service

  reload [svc]  Reload service (picks up code changes)
  clear-errors  Clear launchd error states

  latest        Restart all services to pick up latest code
  on            Turn on all services (exit hibernation)
  off           Turn off all services (hibernation mode)

  instructions  Show Claude Chat project files to upload
  regen-style   Regenerate style card from Zikaron data

  help          Show this help

EXAMPLES:
  golems                # Quick status overview
  golems services       # Detailed service status
  golems logs telegram  # Tail telegram bot logs
  golems restart telegram
  golems scrape         # Trigger job scrape now
  golems latest         # Deploy latest code to all services
  golems off            # Hibernate (stop all services)
  golems on             # Wake up (start all services)

DOCS:
  ~/Gits/golems/packages/autonomous/CLAUDE.md

EOF
}

cmd_status() {
  echo -e "${BLUE}=== GOLEMS STATUS ===${NC}"
  echo

  # Telegram bot
  if lsof -i :3847 &>/dev/null; then
    echo -e "$(status_icon 0) Telegram Bot     running (port 3847)"
  else
    echo -e "$(status_icon 1) Telegram Bot     not running"
  fi

  # Ollama (local, via launchd)
  if pgrep -q ollama 2>/dev/null; then
    echo -e "$(status_icon 0) Ollama           running"
  else
    echo -e "$(status_icon 1) Ollama           not running"
  fi

  # LaunchAgents summary
  echo
  echo -e "${BLUE}LaunchAgents:${NC}"
  for svc in nightshift briefing job-golem email-golem session-archiver; do
    status=$(launchctl list 2>/dev/null | grep "com.golemszikaron.$svc\|com.golems.$svc" | awk '{print $1}')
    if [ -z "$status" ]; then
      echo -e "  $(status_icon 1) $svc (not loaded)"
    elif [ "$status" = "0" ] || [ "$status" = "-" ]; then
      echo -e "  $(status_icon 0) $svc"
    else
      echo -e "  $(status_icon 1) $svc (exit: $status)"
    fi
  done

  # Claude sessions
  sessions=$(ps aux | grep -c "[c]laude " 2>/dev/null || echo 0)
  echo
  echo -e "${BLUE}Claude Sessions:${NC} $sessions running"

  # State info
  if [ -f "$STATE_FILE" ]; then
    target=$(jq -r '.nightShiftTarget // "none"' "$STATE_FILE" 2>/dev/null)
    echo -e "${BLUE}Night Shift Target:${NC} $target"
  fi
}

cmd_services() {
  echo -e "${BLUE}=== LAUNCHD SERVICES ===${NC}"
  echo
  printf "%-25s %-8s %s\n" "SERVICE" "STATUS" "NOTES"
  printf "%-25s %-8s %s\n" "-------" "------" "-----"

  launchctl list 2>/dev/null | grep -E "golem|zikaron" | while read status pid label; do
    if [ "$status" = "-" ]; then
      status="idle"
    elif [ "$status" = "0" ]; then
      status="ok"
    else
      status="err:$status"
    fi
    printf "%-25s %-8s %s\n" "$label" "$status" ""
  done
}

cmd_docker() {
  echo -e "${BLUE}=== DOCKER CONTAINERS ===${NC}"
  docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null | grep -E "NAME|ollama"

  echo
  echo -e "${BLUE}Health Check:${NC}"
  docker inspect ollama-sandbox --format='{{range .State.Health.Log}}{{.End}}: {{.ExitCode}} - {{.Output}}{{end}}' 2>/dev/null | tail -3
}

cmd_sessions() {
  echo -e "${BLUE}=== CLAUDE SESSIONS ===${NC}"
  ps aux | grep "[c]laude " | awk '{printf "PID: %s  CPU: %s%%  Started: %s\n", $2, $3, $9}'
}

cmd_logs() {
  local name="${1:-telegram}"
  case "$name" in
    telegram)
      tail -f "$LOGS_DIR/telegram-bot.log" 2>/dev/null || tail -f /tmp/golemszikaron-telegram.log 2>/dev/null || echo "No telegram logs found"
      ;;
    nightshift)
      tail -f /tmp/nightshift.log 2>/dev/null || echo "No nightshift logs found"
      ;;
    job-golem|job)
      tail -f /tmp/job-golem.err /tmp/job-golem.log 2>/dev/null || echo "No job-golem logs found"
      ;;
    archiver)
      tail -f "$LOGS_DIR/session-archiver.log" 2>/dev/null || echo "No archiver logs found"
      ;;
    *)
      echo "Unknown log: $name"
      echo "Available: telegram, nightshift, job-golem, archiver"
      ;;
  esac
}

cmd_start() {
  local svc="$1"
  case "$svc" in
    telegram|bot)
      cd "$GOLEMS_HOME" && bun run bot &
      echo "Started telegram bot"
      ;;
    nightshift)
      launchctl load ~/Library/LaunchAgents/com.golemszikaron.nightshift.plist 2>/dev/null
      echo "Loaded nightshift launchd"
      ;;
    ollama)
      launchctl load ~/Library/LaunchAgents/com.golemszikaron.ollama.plist 2>/dev/null
      echo "Started ollama via launchd"
      ;;
    job-golem|job)
      launchctl load ~/Library/LaunchAgents/com.golemszikaron.job-golem.plist 2>/dev/null
      echo "Loaded job-golem launchd"
      ;;
    email-golem|email)
      launchctl load ~/Library/LaunchAgents/com.golemszikaron.email-golem.plist 2>/dev/null
      echo "Loaded email-golem launchd"
      ;;
    *)
      echo "Unknown service: $svc"
      echo "Available: telegram, nightshift, ollama, job-golem, email-golem"
      ;;
  esac
}

cmd_stop() {
  local svc="$1"
  case "$svc" in
    telegram|bot)
      pkill -f "bun.*telegram-bot" 2>/dev/null || echo "Not running"
      echo "Stopped telegram bot"
      ;;
    nightshift)
      launchctl bootout gui/$(id -u)/com.golemszikaron.nightshift 2>/dev/null || true
      pkill -f "night-shift" 2>/dev/null || true
      echo "Stopped nightshift"
      ;;
    ollama)
      launchctl unload ~/Library/LaunchAgents/com.golemszikaron.ollama.plist 2>/dev/null
      pkill -f ollama 2>/dev/null || true
      echo "Stopped ollama"
      ;;
    job-golem|job)
      launchctl unload ~/Library/LaunchAgents/com.golemszikaron.job-golem.plist 2>/dev/null
      echo "Stopped job-golem"
      ;;
    email-golem|email)
      launchctl unload ~/Library/LaunchAgents/com.golemszikaron.email-golem.plist 2>/dev/null
      echo "Stopped email-golem"
      ;;
    *)
      echo "Unknown service: $svc"
      ;;
  esac
}

cmd_restart() {
  local svc="$1"
  cmd_stop "$svc"
  sleep 1
  cmd_start "$svc"
}

cmd_scrape() {
  echo "Triggering job scrape..."
  if curl --fail -s http://localhost:3847/scrape-jobs; then
    echo ""
    echo "Scrape started. Check: golems logs telegram"
  else
    echo ""
    echo -e "${RED}Failed to trigger job scrape.${NC} Is telegram bot running?"
    echo "Start with: golems start telegram"
    exit 1
  fi
}

cmd_clear_errors() {
  echo "Clearing launchd error states..."
  for label in com.golemszikaron.job-golem com.golemszikaron.email-golem com.golemszikaron.ollama; do
    launchctl bootout gui/$(id -u)/$label 2>/dev/null || true
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/${label}.plist 2>/dev/null || true
  done
  echo "Done. Check: golems services"
}

# All core services (for on/off/latest)
CORE_SERVICES="telegram job-golem email-golem ollama"
SCHEDULED_SERVICES="nightshift briefing"

cmd_latest() {
  echo -e "${BLUE}=== DEPLOYING LATEST CODE ===${NC}"
  echo "Restarting all services to pick up code changes..."
  echo

  # TODO: Telegram uses `bun run bot &` not launchd, so `launchctl kickstart` fails for it.
  # Fix: migrate telegram to use launchd consistently like other services.
  # See PR #7 deferred bug #1.

  # Restart via launchctl kickstart -k (keeps service running, just restarts)
  for svc in $CORE_SERVICES; do
    [ "$svc" = "ollama" ] && continue
    label="com.golemszikaron.$svc"
    echo -n "  Restarting $svc... "
    if launchctl kickstart -k gui/$(id -u)/$label 2>/dev/null; then
      echo -e "${GREEN}done${NC}"
    else
      echo -e "${YELLOW}not running${NC}"
    fi
  done

  echo
  echo -e "${GREEN}✓ All services restarted with latest code${NC}"
  echo "  Check status: golems status"
}

cmd_on() {
  echo -e "${BLUE}=== WAKING UP GOLEMS ===${NC}"
  echo "Starting all services..."
  echo

  # Start core services
  for svc in $CORE_SERVICES; do
    echo -n "  Starting $svc... "
    cmd_start "$svc" 2>/dev/null && echo -e "${GREEN}done${NC}" || echo -e "${YELLOW}already running${NC}"
  done

  # Load scheduled services
  for svc in $SCHEDULED_SERVICES; do
    echo -n "  Loading $svc... "
    launchctl load ~/Library/LaunchAgents/com.golemszikaron.$svc.plist 2>/dev/null && echo -e "${GREEN}done${NC}" || echo -e "${YELLOW}already loaded${NC}"
  done

  echo
  echo -e "${GREEN}✓ All golems are awake${NC}"
  cmd_status
}

cmd_off() {
  echo -e "${BLUE}=== HIBERNATING GOLEMS ===${NC}"
  echo "Stopping all services..."
  echo

  # Stop core services
  for svc in $CORE_SERVICES; do
    echo -n "  Stopping $svc... "
    cmd_stop "$svc" 2>/dev/null
    echo -e "${GREEN}done${NC}"
  done

  # Unload scheduled services
  for svc in $SCHEDULED_SERVICES; do
    echo -n "  Unloading $svc... "
    launchctl unload ~/Library/LaunchAgents/com.golemszikaron.$svc.plist 2>/dev/null && echo -e "${GREEN}done${NC}" || echo -e "${YELLOW}not loaded${NC}"
  done

  # Kill any lingering Claude sessions
  pkill -f "claude " 2>/dev/null || true

  echo
  echo -e "${YELLOW}💤 All golems are hibernating${NC}"
  echo "  Wake up with: golems on"
}

CHAT_DIR="$HOME/Gits/golems/contexts/claude-chat"

cmd_instructions() {
  local golem="$1"
  echo -e "${BLUE}=== CLAUDE CHAT PROJECT FILES ===${NC}"
  echo
  echo "Upload these files to your claude.ai projects:"
  echo

  if [ -n "$golem" ]; then
    # Show specific golem
    local file="$CHAT_DIR/${golem}.md"
    if [ -f "$file" ]; then
      echo -e "  ${GREEN}$file${NC}"
      echo
      echo "--- Content Preview ---"
      head -20 "$file"
      echo "..."
      echo
      echo -e "Copy to clipboard: ${YELLOW}cat $file | pbcopy${NC}"
    else
      echo -e "${RED}No instructions for: $golem${NC}"
      echo "Available:"
      ls "$CHAT_DIR"/*.md 2>/dev/null | grep -v README | xargs -I{} basename {} .md | sed 's/^/  /'
    fi
  else
    # List all
    for file in "$CHAT_DIR"/*.md; do
      [ "$(basename "$file")" = "README.md" ] && continue
      local name=$(basename "$file" .md)
      local updated=$(grep "Last updated" "$file" 2>/dev/null | head -1 | sed 's/.*: //')
      printf "  %-25s %s\n" "$name" "(updated: ${updated:-unknown})"
    done
    echo
    echo -e "Upload to claude.ai → Projects → [golem name] → Add files"
    echo -e "Always include ${YELLOW}style-card.md${NC} alongside golem instructions."
    echo
    echo -e "Details: ${YELLOW}golems instructions <golem-name>${NC}"
    echo -e "Regenerate style card: ${YELLOW}golems regen-style${NC}"
  fi
}

cmd_regen_style() {
  echo "Regenerating style card from Zikaron data..."
  cd "$GOLEMS_HOME" && bun src/lib/style-export.ts "$CHAT_DIR/style-card.md"
  echo -e "${GREEN}✓ Style card updated${NC}"
  echo "  Re-upload to your claude.ai projects."
}

# Main
case "${1:-status}" in
  help|--help|-h)
    cmd_help
    ;;
  status)
    cmd_status
    ;;
  services|svc)
    cmd_services
    ;;
  scrape)
    cmd_scrape
    ;;
  sessions)
    cmd_sessions
    ;;
  logs)
    cmd_logs "$2"
    ;;
  start)
    cmd_start "$2"
    ;;
  stop)
    cmd_stop "$2"
    ;;
  restart)
    cmd_restart "$2"
    ;;
  reload)
    # Reload delegates to restart for code consistency
    cmd_restart "${2:-telegram}"
    echo "Reloaded ${2:-telegram}"
    ;;
  clear-errors|clear)
    cmd_clear_errors
    ;;
  latest|deploy)
    cmd_latest
    ;;
  on|wake|up)
    cmd_on
    ;;
  off|hibernate|sleep)
    cmd_off
    ;;
  instructions|instr)
    cmd_instructions "$2"
    ;;
  regen-style|style)
    cmd_regen_style
    ;;
  *)
    echo "Unknown command: $1"
    echo "Run 'golems help' for usage"
    exit 1
    ;;
esac
