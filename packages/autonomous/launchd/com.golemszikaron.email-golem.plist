<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.golemszikaron.email-golem</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/etanheyman/.bun/bin/bun</string>
        <string>/Users/etanheyman/Gits/golems/packages/autonomous/src/email-golem/index.ts</string>
    </array>

    <!-- Run every 10 minutes (600 seconds) -->
    <key>StartInterval</key>
    <integer>600</integer>

    <key>StandardOutPath</key>
    <string>/tmp/golemszikaron-email-golem.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/golemszikaron-email-golem.log</string>

    <!--
    IMPORTANT: This is a TEMPLATE. Before installing, copy to ~/Library/LaunchAgents/
    and add these environment variables with your actual values:
    - SUPABASE_URL
    - SUPABASE_ANON_KEY
    - GMAIL_CLIENT_ID
    - GMAIL_CLIENT_SECRET
    - GMAIL_REFRESH_TOKEN
    - OLLAMA_HOST

    See .env file for values.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/etanheyman</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/etanheyman/.bun/bin</string>
    </dict>

    <!-- Don't run immediately on load -->
    <key>WorkingDirectory</key>
    <string>/Users/etanheyman/Gits/golems/packages/autonomous</string>

    <key>RunAtLoad</key>
    <false/>

    <!-- Process nice level - be kind to CPU -->
    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
