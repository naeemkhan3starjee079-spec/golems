{
  "_comment": "Copy to .mcp.json and replace op:// refs with real values from 1Password",
  "_sync": "KEEP IN SYNC: live config at .mcp.json (gitignored), backup at ~/.golems/.mcp.json.backup, registry at ~/.golems/backup-registry.md",
  "_updated": "2026-02-21",
  "_recovery": "If .mcp.json is lost, run: op item get <item-name> --vault <vault> --fields ACCESS_TOKEN",
  "mcpServers": {
    "sophtron": {
      "command": "npx",
      "args": ["@sophtron/sophtron-mcp-server"],
      "env": {
        "SOPHTRON_USER_ID": "op://<your-vault>/sophtron/SOPHTRON_USER_ID",
        "SOPHTRON_ACCESS_KEY": "op://<your-vault>/sophtron/SOPHTRON_ACCESS_KEY"
      }
    },
    "brainlayer": {
      "command": "brainlayer-mcp"
    },
    "golems-email": {
      "command": "bun",
      "args": ["run", "packages/shared/src/email/mcp-server.ts"]
    },
    "golems-jobs": {
      "command": "bun",
      "args": ["run", "packages/jobs/src/mcp-server.ts"]
    },
    "golems-glm": {
      "command": "bun",
      "args": ["run", "packages/shared/src/glm/mcp-server.ts"]
    },
    "qa-voice": {
      "command": "bun",
      "args": ["run", "~/Gits/voicelayer/src/mcp-server.ts"]
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server-supabase@latest", "--access-token", "op://<your-vault>/mcp-supabase/ACCESS_TOKEN"],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "op://<your-vault>/mcp-supabase/ACCESS_TOKEN"
      }
    },
    "exa": {
      "command": "npx",
      "args": ["-y", "exa-mcp-server"],
      "env": {
        "EXA_API_KEY": "op://<your-vault>/exa/EXA_API_KEY"
      }
    }
  }
}
