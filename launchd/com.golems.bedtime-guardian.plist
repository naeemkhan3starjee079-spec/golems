<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.golems.bedtime-guardian</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/etanheyman/.bun/bin/bun</string>
        <string>run</string>
        <string>/Users/etanheyman/Gits/golems/packages/services/src/bedtime-guardian.ts</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/etanheyman/Gits/golems</string>

    <key>StartCalendarInterval</key>
    <array>
        <!-- First reminder: 2:30 AM -->
        <dict>
            <key>Hour</key>
            <integer>2</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <!-- Final warning: 3:30 AM -->
        <dict>
            <key>Hour</key>
            <integer>3</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/tmp/golems-bedtime-guardian.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/golems-bedtime-guardian.log</string>
</dict>
</plist>
